;-    .-.
;-   /'v'\   SISKIN-Builder project file
;-  (/uOu\)  https://github.com/Siskin-framework/Builder/
;-===="="=======================================================================

github: zlib-ng/zlib-ng /2.3.3

version: 2.3.3

compiler: clang
arch:     x64
optimize: 2

;define: USE_TRACES

;- options common for all Rebol extensions ----------------------
#if Windows? [
	define: TO_WINDOWS
	define: _CRT_SECURE_NO_WARNINGS
	set-env CMAKE_GEN: {-G "Visual Studio 17 2022"}
]
#if macOS?   [
	define: TO_OSX
	define: HAS_BOOL
	set-env CMAKE_GEN: ""
]
#if Linux? [
	define: TO_LINUX
	compiler: gcc
	set-env CMAKE_GEN: ""
	cflags: -fvisibility=hidden
]

define: ENDIAN_LITTLE

target-x86: [
	;- On linux needs:  sudo apt install gcc-multilib g++-multilib
	arch: x86
	set ARCH_NAME: "x86"
	set SISKIN_INSTALL_PREFIX: "$SISKIN_INSTALL/$INSTALL_SUFFIX/x86"
	#if macOS?   [ fail "It is not possible to make 32bit build on macos" ]
	#if Posix?   [
		set CMAKE_ARCH: "-DCMAKE_C_FLAGS=-m32 -DCMAKE_CXX_FLAGS=-m32"
	]
	#if Windows? [
		flags: "-arch x86_64"
		set CMAKE_ARCH: "-A Win32"
	]
]
target-x64: [
	arch: x64
	set ARCH_NAME: "x64"
	set SISKIN_INSTALL_PREFIX: "$SISKIN_INSTALL/$INSTALL_SUFFIX/x64"
	defines: [
		_FILE_OFFSET_BITS=64
		__LP64__ ; has long (integer) 64 bits
	]
	#if Windows? [ set CMAKE_ARCH: "-A x64" ]
	#if Posix?   [ set CMAKE_ARCH: ""]
	#if macOS?   [
		flags: ["-arch x86_64"]
		set CMAKE_ARCH: [
			"-DCMAKE_OSX_SYSROOT=macosx"
			"-DCMAKE_OSX_ARCHITECTURES=x86_64"
			"-DCMAKE_APPLE_SILICON_PROCESSOR=x86_64" ;; make CMake treat the build as x86_64, not the arm64 host
			"-DCMAKE_OSX_DEPLOYMENT_TARGET=10.9"
		]
	]
]
target-arm64: [
	arch: arm64
	set ARCH_NAME: "arm64"
	set SISKIN_INSTALL_PREFIX: "$SISKIN_INSTALL/$INSTALL_SUFFIX/arm64"
	define: _FILE_OFFSET_BITS=64
	define: __LP64__ ; has long (integer) 64 bits
	define: __arm64__
	#if Posix? [
		#either macOS? [
			flags: "-target arm64-apple-darwin"
			set CMAKE_ARCH: [
				"-DCMAKE_OSX_SYSROOT=macosx"
				"-DCMAKE_OSX_ARCHITECTURES=arm64"
				"-DCMAKE_OSX_DEPLOYMENT_TARGET=11.0"
			]
		][
			;- Needs:  sudo apt install gcc-aarch64-linux-gnu g++-aarch64-linux-gnu
			set CMAKE_ARCH: [
				"-DCMAKE_SYSTEM_NAME=Linux"
				"-DCMAKE_SYSTEM_PROCESSOR=aarch64"
				"-DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc"
				"-DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++"
			]
		]
	]
	#if Windows? [
		set CMAKE_ARCH: "-A arm64"
	]
]
;----------------------------------------------------------------


;----------------------------------------------------------------
;- extension sources are built out of the Rebol tree -------------
;; Selects the amalgamated `rebol-extension.h` in the generated header.
define: REB_EXT

r3-extension: [
	flags: shared
	strip: on
	source: %src/
	include: %$SISKIN_INSTALL_PREFIX/include/
	library: %$SISKIN_INSTALL_PREFIX/lib/
	files: only [
		%zlib-ng.c
		%zlib-ng-commands.c
		%gen-zlib-ng.c
	]
	#if macOS? [
		compiler: clang
		lflag:  "-dynamiclib"
		cflag:  "-mmacosx-version-min=10.9"
		;; Export only the extension entry points.
		lflag: "-Wl,-exported_symbol,_RX_Init -Wl,-exported_symbol,_RX_Quit -Wl,-exported_symbol,_RX_Call -Wl,-exported_symbol,_RX_Abi"
		lflag: "-Wl,-dead_strip"
	]
	#if Posix? [
		cflags: [-fPIC -pthread]
		libraries: [%pthread]
	]
	#if Linux? [
		lflag: "-Wl,--exclude-libs,ALL"
		lflag: "-Wl,--gc-sections"
		lflag: "-Wl,--no-undefined"   ;; fail at link time, not at load time
		library: %pthread
	]
	#if Windows? [
		upx: on
	]
	;- generate the extension header and command table -------------
	;; Produces %src/gen-zlib-ng.h and %src/gen-zlib-ng.c, and refreshes
	;; %README.md's reference section (make-extension.r3 0.7.0+ only
	;; touches the README when --readme is passed).
	do %make-extension.r3 [%src/zlib-ng.reb --readme]
]

;; Library names, with the native API (ZLIB_COMPAT=OFF, so the `-ng` suffix):
;; MSVC names the static library `zlibstatic-ng` and the shared (import)
;; library `zlib-ng`; everywhere else both are `z-ng`.
link-static: [
	set CMAKE_LINK: "-DBUILD_SHARED_LIBS=OFF"
	set INSTALL_SUFFIX: "static"
	set DIR_SUFFIX: ""
	#either windows? [
		library: %zlibstatic-ng
	][	library: %z-ng]
]
link-shared: [
	set CMAKE_LINK: "-DBUILD_SHARED_LIBS=ON"
	set INSTALL_SUFFIX: "shared"
	set DIR_SUFFIX: "-shared"
	#either windows? [
		library: %zlib-ng
	][	library: %z-ng]
]

cmake-build: [
	set CMAKE_COMMON: [
		"-DCMAKE_BUILD_TYPE=Release"
		"-DCMAKE_VERBOSE_MAKEFILE=OFF"
		;; native zng_* API (the extension uses zlib-ng.h, not zlib.h)
		"-DZLIB_COMPAT=OFF"
		;; no tests, which also disables gtest
		"-DBUILD_TESTING=OFF"
		;; the static library is linked into a shared extension
		"-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
		;; GNUInstallDirs may pick lib64 on some Linux distros
		"-DCMAKE_INSTALL_LIBDIR=lib"
		"-DCMAKE_INSTALL_PREFIX=$SISKIN_INSTALL_PREFIX"
	;- Above defined based on target
		"$CMAKE_ARCH"
		"$CMAKE_LINK"

	]
	cmd "cmake --fresh -B $SISKIN_TEMP/zlib-ng-$ARCH_NAME$DIR_SUFFIX $CMAKE_GEN -S zlib-ng $CMAKE_COMMON"
	cmd "cmake --build    $SISKIN_TEMP/zlib-ng-$ARCH_NAME$DIR_SUFFIX --config release -j 8"
	cmd "cmake --install  $SISKIN_TEMP/zlib-ng-$ARCH_NAME$DIR_SUFFIX --config release"
]

eggs: [
	"Cmake Zlib-ng static - x86"  [ name: %cmake-zlib-ng-x86          :link-static :target-x86   :cmake-build ]
	"Cmake Zlib-ng static - x64"  [ name: %cmake-zlib-ng-x64          :link-static :target-x64   :cmake-build ]
	"Cmake Zlib-ng static - arm64"[ name: %cmake-zlib-ng-arm64        :link-static :target-arm64 :cmake-build ]
	"Cmake Zlib-ng shared - x86"  [ name: %cmake-zlib-ng-shared-x86   :link-shared :target-x86   :cmake-build ]
	"Cmake Zlib-ng shared - x64"  [ name: %cmake-zlib-ng-shared-x64   :link-shared :target-x64   :cmake-build ]
	"Cmake Zlib-ng shared - arm64"[ name: %cmake-zlib-ng-shared-arm64 :link-shared :target-arm64 :cmake-build ]

	"Rebol Zlib-ng static extension: x86" [
		name: %zlib-ng-x86
		:link-static :target-x86 :r3-extension
	]
	"Rebol Zlib-ng static extension: x64" [
		name: %zlib-ng-x64
		:link-static :target-x64 :r3-extension
	]
	"Rebol Zlib-ng static extension: arm64" [
		name: %zlib-ng-arm64
		:link-static :target-arm64 :r3-extension
	]

	"Rebol Zlib-ng shared extension: x86" [
		name: %zlib-ng-shared-x86
		:link-shared :target-x86 :r3-extension
	]
	"Rebol Zlib-ng shared extension: x64" [
		name: %zlib-ng-shared-x64
		:link-shared :target-x64 :r3-extension
	]
	"Rebol Zlib-ng shared extension: arm64" [
		name: %zlib-ng-shared-arm64
		:link-shared :target-arm64 :r3-extension
	]
]
